{
  "name": "n8n-nodes-hazelchat",
  "version": "0.1.0",
  "description": "Hazelchat nodes for n8n: start a workflow when a visitor leaves an enquiry with your Hazelchat website agent, or read recent enquiries.",
  "license": "MIT",
  "homepage": "https://hazelchat.co/docs/api/",
  "keywords": [
    "n8n-community-node-package",
    "hazelchat",
    "website chat",
    "enquiries",
    "leads"
  ],
  "author": {
    "name": "Hazelchat",
    "email": "hello@hazelchat.co"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hazelchat-co/n8n-nodes-hazelchat.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test test/*.test.mjs",
    "scan": "node scripts/scan-local.mjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HazelchatApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Hazelchat/Hazelchat.node.js",
      "dist/nodes/HazelchatTrigger/HazelchatTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.51.4",
    "eslint": "9.39.4",
    "n8n-workflow": "2.42.3",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
